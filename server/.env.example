# ── Database ────────────────────────────────────────────────────────────────
# MongoDB connection string (Atlas "mongodb+srv://…" or a standard seedlist).
# The app targets the database named by MONGODB_DB (default: college_erp).
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0"
MONGODB_DB=college_erp

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-too-to-another-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# ── Seed ────────────────────────────────────────────────────────────────────
# Initial password for the one-per-role login accounts created by `npm run seed`.
# REQUIRED (seed aborts if unset/short). Use a strong secret; NEVER commit the real value.
SEED_PASSWORD=change-me-to-a-strong-secret-min-8-chars

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# ── Files ───────────────────────────────────────────────────────────────────
# Local folder for uploads in dev; use S3/GCS in production
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
