# ── Database ────────────────────────────────────────────────────────────────
# Cloud/managed PostgreSQL connection string (Supabase, Neon, Render, RDS…)
# NEVER use a local Windows folder as the production database.
DATABASE_URL="postgresql://user:password@host:5432/college_erp?schema=public&sslmode=require"

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-too-to-another-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# ── Files ───────────────────────────────────────────────────────────────────
# Local folder for uploads in dev; use S3/GCS in production
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
